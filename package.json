{
  "name": "ycombinator1.com",
  "version": "0.0.1",
  "description": "OpenGraph proxy and Slack app for news.ycombinator.com URLs",
  "main": "dist/server.js",
  "type": "module",
  "repository": "git@github.com:statico/ycombinator1.com.git",
  "author": "Ian Langworth <ian@langworth.com>",
  "license": "Unlicense",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@statico/zerodep-node-http-server": "^0.1.3",
    "date-fns": "^4.4.0",
    "html-entities": "^2.6.0",
    "html-to-text": "^10.0.1",
    "pluralize": "^8.0.0",
    "s3mini": "^0.9.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^25.9.3",
    "@types/pluralize": "^0.0.33",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
